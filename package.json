{
  "name": "epxsc-syntax",
  "version": "2.0.0",
  "private": true,
  "description": "Obsidian plugin: EpXsC syntax highlighting, hover dictionary, and linting",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate.mjs && node scripts/generate-lexicon.mjs --check",
    "test": "node scripts/test.mjs && node scripts/fixture-runner.mjs && node scripts/cli-test.mjs",
    "bench": "node scripts/bench.mjs",
    "release:check": "node scripts/check-release-assets.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "bin": {
    "epxsc": "bin/epxsc.mjs"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./cli": "./bin/epxsc.mjs"
  }
}
